clc;
clear;
close all;
Fs = 10000; % Sampling Frequency
N = 4; % Filter Order
Fc = [1000 2000 3000]; % Cutoff Frequencies
for k = 1:length(Fc)
Wn = Fc(k)/(Fs/2);
% High Pass Filter Design
[b,a] = butter(N,Wn,'high');
% Frequency Response
[H,f] = freqz(b,a,1024,Fs);
% Magnitude Response
figure;
plot(f,20*log10(abs(H)),'LineWidth',2);
grid on;
xlabel('Frequency (Hz)');
ylabel('Magnitude (dB)');
title(['Magnitude Response of HPF (Fc = ',num2str(Fc(k)),' Hz)']);
% Phase Response
figure;
plot(f,angle(H)*180/pi,'LineWidth',2);
grid on;
xlabel('Frequency (Hz)');
ylabel('Phase (Degrees)');
title(['Phase Response of HPF (Fc = ',num2str(Fc(k)),' Hz)']);
end
