clc;
clear;
close all;

% Characteristic Impedance
Z0 = 50;

% Load Impedance Values
ZL = [25 50 100];

% Initialize Variables
Gamma = zeros(size(ZL));
Gamma_mag = zeros(size(ZL));
Pref = zeros(size(ZL));
Ptrans = zeros(size(ZL));

for i = 1:length(ZL)

    % Reflection Coefficient
    Gamma(i) = (ZL(i)-Z0)/(ZL(i)+Z0);

    % Magnitude of Reflection Coefficient
    Gamma_mag(i) = abs(Gamma(i));

    % Reflected Power Percentage
    Pref(i) = (Gamma_mag(i)^2)*100;

    % Transmitted Power Percentage
    Ptrans(i) = (1-Gamma_mag(i)^2)*100;

end

% Display Results
disp('Load Impedance Reflection Analysis');

Results = table(ZL', Gamma_mag', Pref', Ptrans', ...
    'VariableNames', {'ZL_Ohm', 'Gamma', ...
    'ReflectedPower_Percent', 'TransmittedPower_Percent'});

disp(Results);

% Graph 1: Reflection Coefficient vs Load Impedance
figure;
plot(ZL, Gamma_mag, '-o', 'LineWidth', 2);
grid on;
xlabel('Load Impedance (Ohms)');
ylabel('Reflection Coefficient');
title('Reflection Coefficient vs Load Impedance');

% Graph 2: Transmitted Power Percentage
figure;
bar(Ptrans);
grid on;
xlabel('Case Number');
ylabel('Transmitted Power (%)');
title('Transmitted Power Percentage');
