clc;
clear;
close all;
% Angular Range
theta = linspace(0,2*pi,1000);
% Approximate Stripline Antenna Pattern
E = abs(cos(theta));
% Normalization
E_norm = E/max(E);
% Polar Plot
figure;
polarplot(theta,E_norm,'LineWidth',2);
title('Radiation Pattern of Stripline Antenna');
grid on;
% Cartesian Plot
figure;
plot(rad2deg(theta),E_norm,'LineWidth',2);
grid on;
xlabel('Angle (Degrees)');
ylabel('Normalized Radiation Intensity');
title('Stripline Antenna Radiation Pattern');
